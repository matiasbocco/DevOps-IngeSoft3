server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # La dirección del backend y el DNS llegan por variables de entorno al arrancar:
    # en compose, el nombre del servicio y el DNS de Docker; en otro entorno, la URL de
    # la api de ESE entorno. La misma imagen sirve en QA y en PROD.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;
    }

    location /health {
        proxy_pass $backend_api;
    }
}
